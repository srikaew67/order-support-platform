pipeline {
    agent { label 'docker-java21-node22' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(name: 'PUBLISH_IMAGES', defaultValue: false,
            description: 'Push tested images from the main branch to the registry')
        booleanParam(name: 'DEPLOY_TO_K8S', defaultValue: false,
            description: 'Deploy the published images and check the public endpoint')
        string(name: 'REGISTRY_HOST', defaultValue: 'registry.example.com',
            description: 'Registry host, with an optional port')
        string(name: 'REGISTRY_NAMESPACE', defaultValue: 'order-support',
            description: 'Repository namespace in the registry')
        string(name: 'KUBE_NAMESPACE', defaultValue: 'order-support',
            description: 'Kubernetes namespace for deployment')
        string(name: 'SMOKE_BASE_URL', defaultValue: '',
            description: 'Public frontend URL to check after deployment')
    }

    environment {
        CI = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
                sh 'mkdir -p reports'
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    if (!(env.GIT_SHA ==~ /[0-9a-f]{40}/)) {
                        error('Checkout did not produce a full Git commit SHA')
                    }
                    env.IMAGE_TAG = "sha-${env.GIT_SHA}"
                }
            }
        }

        stage('Validate release settings') {
            steps {
                script {
                    if (!(params.REGISTRY_HOST ==~ /[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{2,5})?/)) {
                        error('REGISTRY_HOST must be a host with an optional port')
                    }
                    if (!(params.REGISTRY_NAMESPACE ==~ /[a-z0-9]+(?:[._\/-][a-z0-9]+)*/)) {
                        error('REGISTRY_NAMESPACE contains invalid characters')
                    }
                    if (!(params.KUBE_NAMESPACE ==~ /[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/) ||
                            params.KUBE_NAMESPACE.length() > 63) {
                        error('KUBE_NAMESPACE must be a DNS label')
                    }
                    if (params.DEPLOY_TO_K8S && !params.PUBLISH_IMAGES) {
                        error('DEPLOY_TO_K8S requires PUBLISH_IMAGES')
                    }
                    if (params.PUBLISH_IMAGES) {
                        if (env.BRANCH_NAME != 'main') {
                            error('Publishing is allowed only from the main branch of a Multibranch Pipeline')
                        }
                        if (params.REGISTRY_HOST == 'registry.example.com') {
                            error('Set REGISTRY_HOST to the real private registry before publishing')
                        }
                    }
                    if (params.DEPLOY_TO_K8S) {
                        if (!(params.SMOKE_BASE_URL ==~ /https?:\/\/[^\s]+/)) {
                            error('SMOKE_BASE_URL must be an HTTP(S) URL')
                        }
                        if (!fileExists('infra/kubernetes/kustomization.yaml')) {
                            error('Kubernetes manifests from Task 9 are required for deployment')
                        }
                    }
                    env.IMAGE_PREFIX = "${params.REGISTRY_HOST}/${params.REGISTRY_NAMESPACE}"
                    env.REGISTRY_HOST = params.REGISTRY_HOST
                    env.KUBE_NAMESPACE = params.KUBE_NAMESPACE
                }
            }
        }

        stage('Secret scan') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
gitleaks git --no-banner --redact --report-format sarif --report-path reports/gitleaks-history.sarif .
gitleaks dir --no-banner --redact --report-format sarif --report-path reports/gitleaks-worktree.sarif .
'''
            }
        }

        stage('Backend tests') {
            parallel {
                stage('Order service') {
                    steps {
                        dir('backend/order-service') {
                            sh '''#!/usr/bin/env bash
set -euo pipefail
../mvnw -B -ntp '-Dtest=*Test,*IT,*Tests' test 2>&1 | tee ../../reports/order-tests.log
'''
                        }
                    }
                }
                stage('Support service') {
                    steps {
                        dir('backend/support-service') {
                            sh '''#!/usr/bin/env bash
set -euo pipefail
../mvnw -B -ntp '-Dtest=*Test,*IT,*Tests' test 2>&1 | tee ../../reports/support-tests.log
'''
                        }
                    }
                }
                stage('Notification service') {
                    steps {
                        dir('backend/notification-service') {
                            sh '''#!/usr/bin/env bash
set -euo pipefail
../mvnw -B -ntp '-Dtest=*Test,*IT,*Tests' test 2>&1 | tee ../../reports/notification-tests.log
'''
                        }
                    }
                }
            }
        }

        stage('Frontend tests and build') {
            steps {
                dir('frontend') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
npm ci
npm test -- --watch=false --browsers=ChromeHeadless 2>&1 | tee ../reports/frontend-tests.log
npm run build 2>&1 | tee ../reports/frontend-build.log
'''
                }
            }
        }

        stage('Build images') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
for service in order-service support-service notification-service; do
    docker build -t "$IMAGE_PREFIX/$service:$IMAGE_TAG" "backend/$service"
done
docker build -t "$IMAGE_PREFIX/frontend:$IMAGE_TAG" frontend
'''
            }
        }

        stage('Full-stack smoke') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
scripts/verify-e2e.sh 2>&1 | tee reports/e2e.log
'''
            }
        }

        stage('Publish images') {
            when { expression { params.PUBLISH_IMAGES } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'container-registry',
                        usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
set +x
export DOCKER_CONFIG="$(mktemp -d)"
trap 'python3 -c '\''import shutil,sys; shutil.rmtree(sys.argv[1])'\'' "$DOCKER_CONFIG"' EXIT
printf '%s' "$REGISTRY_PASSWORD" | docker login "$REGISTRY_HOST" \
    --username "$REGISTRY_USER" --password-stdin
for service in order-service support-service notification-service frontend; do
    if docker manifest inspect "$IMAGE_PREFIX/$service:$IMAGE_TAG" >/dev/null 2>&1; then
        echo "Immutable image tag already exists: $service:$IMAGE_TAG" >&2
        exit 1
    fi
done
for service in order-service support-service notification-service frontend; do
    docker push "$IMAGE_PREFIX/$service:$IMAGE_TAG"
done
'''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when { expression { params.DEPLOY_TO_K8S } }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
kubectl -n "$KUBE_NAMESPACE" apply -k infra/kubernetes
for service in order-service support-service notification-service frontend; do
    kubectl -n "$KUBE_NAMESPACE" set image "deployment/$service" \
        "$service=$IMAGE_PREFIX/$service:$IMAGE_TAG"
    kubectl -n "$KUBE_NAMESPACE" rollout status "deployment/$service" --timeout=300s
done
'''
                }
            }
        }

        stage('Deployed smoke') {
            when { expression { params.DEPLOY_TO_K8S } }
            steps {
                withEnv(["DEPLOYED_BASE_URL=${params.SMOKE_BASE_URL}"]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
python3 scripts/smoke-deployed.py --base-url "$DEPLOYED_BASE_URL" 2>&1 | tee reports/deployed-smoke.log
'''
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'backend/**/target/surefire-reports/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/**'
        }
    }
}
